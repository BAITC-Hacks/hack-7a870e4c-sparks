# init.sh generates missing local secrets automatically.
# For manual setup: PostgreSQL password must be URL-safe.
POSTGRES_PASSWORD=replace-with-a-unique-url-safe-password
# Set unique local credentials before starting the application.
HR_PASSWORD=replace-with-a-unique-long-password
CREDENTIAL_SECRET=replace-with-at-least-32-random-characters
DEMO_EMPLOYEE_PASSWORD=replace-with-another-unique-long-password
DEMO_EMPLOYEE_ID=E0005
# Passed only to the Python agent. Empty key enables its rules fallback.
# Add the key locally; do not commit .env. OPENAI_KEY is a legacy alias.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Local API development uses this address. Compose sets http://agent:8000.
AGENT_URL=http://127.0.0.1:8000
# Set true behind HTTPS in production. Local HTTP requires false.
COOKIE_SECURE=false
APP_ORIGIN=http://localhost:3000
API_BIND_ADDRESS=127.0.0.1
API_PORT=3001
