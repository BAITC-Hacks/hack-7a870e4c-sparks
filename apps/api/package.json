{
	"name": "career-quest-api",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"engines": {
		"bun": ">=1.3.14"
	},
	"scripts": {
		"dev": "bun --watch src/index.ts",
		"start": "bun src/index.ts",
		"generate": "bunx --bun prisma generate",
		"migrate:deploy": "bunx --bun prisma migrate deploy",
		"migrate": "bunx --bun prisma migrate dev",
		"typecheck": "tsc --noEmit",
		"test": "bun test tests",
		"openapi": "bun scripts/export-openapi.ts",
		"credentials:employee": "bun scripts/employee-credentials.ts"
	},
	"dependencies": {
		"@elysiajs/openapi": "1.4.16",
		"@prisma/adapter-pg": "7.10.0",
		"@prisma/client": "7.10.0",
		"@sinclair/typebox": "0.34.52",
		"csv-parse": "7.0.2",
		"elysia": "1.4.30",
		"pg": "8.23.0",
		"prisma": "7.10.0"
	},
	"devDependencies": {
		"@types/bun": "1.3.14",
		"@types/pg": "8.23.1",
		"typescript": "5.9.3"
	}
}
