{
  "name": "crystal_architecture",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "biome check . && depcruise src",
    "lint:deps": "depcruise src",
    "lint:unused": "knip",
    "build:analyze": "ANALYZE=true next build --webpack",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "g:module": "hygen module new",
    "g:entity": "hygen entity new",
    "g:component": "hygen module component",
    "g:api": "hygen module api",
    "g:query": "hygen module query",
    "g:mutation": "hygen module mutation",
    "g:store": "hygen module store",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "orval": "orval",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:watch": "vitest --reporter=verbose",
    "test:verbose": "vitest run --reporter=verbose",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css,md}": "biome check --write --no-errors-on-unmatched"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@storybook/react": "^10.6.0",
    "@tanstack/react-query": "^5.103.2",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "dotenv": "^18.0.3",
    "lottie-react": "^3.1.2",
    "lucide-react": "^1.47.0",
    "next": "16.3.6",
    "next-intl": "^4.14.6",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.88.0",
    "recharts": "3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@chromatic-com/storybook": "5.3.1",
    "@next/bundle-analyzer": "^16.3.6",
    "@playwright/test": "^1.63.0",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/addon-onboarding": "10.6.0",
    "@storybook/addon-vitest": "10.6.0",
    "@storybook/nextjs-vite": "^10.6.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "dependency-cruiser": "^18.4.0",
    "husky": "^9.1.7",
    "hygen": "^6.2.11",
    "jsdom": "^29.1.1",
    "knip": "^6.37.0",
    "lint-staged": "^17.5.1",
    "orval": "^8.36.0",
    "playwright": "^1.63.0",
    "storybook": "10.6.0",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": "^24.14.0"
  }
}
