# Next.js proxies /api/* to this server-only origin (no /api suffix).
# Rebuild production web after changing it. Compose uses http://api:3001.
API_INTERNAL_URL=http://127.0.0.1:3001
# Keep empty for same-origin requests. Set only for a separate public API
# with credentials/CORS configured for the frontend origin.
NEXT_PUBLIC_API_URL=
# Orval reads ../../apps/api/openapi.json; it needs no URL variable.
